-    // Empty args: brings up app picker.
-    match main([String::new()].into_iter()) {
+    let mut launch_arguments: Vec<String> = Vec::new();
+    if !argv.is_null() {
+        for index in 0..argc.max(0) as usize {
+            let argument_pointer = unsafe { *argv.add(index) };
+            if argument_pointer.is_null() {
+                continue;
+            }
+            let argument = unsafe { std::ffi::CStr::from_ptr(argument_pointer) };
+            launch_arguments.push(argument.to_string_lossy().into_owned());
+        }
+    }
+    if launch_arguments.is_empty() {
+        launch_arguments.push(String::new());
+    }
+    match main(launch_arguments.into_iter()) {
